PORT=7008
NODE_ENV=development
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
DATA_GOV_DATASET_ID=9ef84268-d588-465a-a308-a864a43d0070
MONGODB_URI=mongodb://localhost:27017/kpms_db
JWT_SECRET=your_super_secret_jwt_key_here

# Brevo (Sendinblue) Transactional HTTP API Configuration
BREVO_API_KEY=xkeysib-your-master-api-key-here
BREVO_SENDER_EMAIL=your-verified-sender@domain.com
BREVO_SENDER_NAME="KPMS Govt Portal"
DEFAULT_FROM_EMAIL="KPMS Govt Portal <your-verified-sender@domain.com>"

# Brevo SMTP Relay Configuration
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-login-id@smtp-brevo.com
EMAIL_HOST_PASSWORD=your-generated-smtp-key-here

# Legacy/Alternative variable naming
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login-id@smtp-brevo.com
SMTP_PASS=your-generated-smtp-key-here
SMTP_FROM="KPMS Govt Portal <your-verified-sender@domain.com>"
